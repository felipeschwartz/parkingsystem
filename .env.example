# Copie para .env (que o git ignora) e preencha. O docker-compose lê este arquivo.

DB_PASSWORD=change-me
# Mínimo de 32 caracteres; a aplicação não sobe com um segredo menor.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Primeiro usuário ADMIN. Preencha os dois (a senha precisa de 12+ caracteres); sem eles não há como
# cadastrar usuários fora do perfil dev. Só cria se ainda não existir nenhum ADMIN e nunca altera a senha
# depois, então vale remover ADMIN_PASSWORD deste arquivo depois do primeiro start e trocá-la pela API.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Deixe vazio em qualquer ambiente real. "dev" liga o DevDatabaseSeeder, que cria usuários
# de teste (incluindo um ADMIN) com senha conhecida; serve só para demonstração local.
SPRING_PROFILES_ACTIVE=

# Swagger UI e /v3/api-docs ficam desligados por padrão fora do perfil dev.
SWAGGER_ENABLED=false

# Porta do Postgres no host (só em localhost). Mude se a 5432 já estiver em uso.
DB_PORT=5432
